# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/demo-store

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Used only by `npm run seed` to create the admin account.
SEED_ADMIN_EMAIL=admin@copperbean.test
SEED_ADMIN_PASSWORD=

# Run the periodic jobs (cancelling unpaid orders) inside the server. Set to false if cron or
# another scheduler runs `npm run job -- <name>` instead.
RUN_JOBS=true
